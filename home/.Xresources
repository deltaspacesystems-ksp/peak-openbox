Xft.dpi: 108
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb

XTerm*faceName: JetBrainsMono Nerd Font Mono
XTerm*faceSize: 11
XTerm*termName: xterm-256color
XTerm*saveLines: 10000
XTerm*scrollBar: false
XTerm*internalBorder: 14
XTerm*borderWidth: 0
XTerm*selectToClipboard: true
XTerm*cursorBlink: true
XTerm*metaSendsEscape: true
XTerm*locale: true
XTerm*utf8: 1

*.foreground: #cdd6f4
*.background: #1e1e2e
*.cursorColor: #f5e0dc

*.color0:  #45475a
*.color8:  #585b70
*.color1:  #f38ba8
*.color9:  #f38ba8
*.color2:  #a6e3a1
*.color10: #a6e3a1
*.color3:  #f9e2af
*.color11: #f9e2af
*.color4:  #89b4fa
*.color12: #89b4fa
*.color5:  #f5c2e7
*.color13: #f5c2e7
*.color6:  #94e2d5
*.color14: #94e2d5
*.color7:  #bac2de
*.color15: #a6adc8

Xcursor.theme: XCursor-Pro-Dark
Xcursor.size: 24
